{
  "name": "spacegear-tech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-content-index.mjs && node scripts/build-upload-variants.mjs && node --experimental-strip-types scripts/check-content.mjs && next build",
    "start": "wrangler dev --local --port 8787",
    "lint": "eslint src worker scripts tests \"*.mjs\" \"*.ts\"",
    "build:cf": "npm run build && node scripts/package-site.mjs && node scripts/check-export.mjs",
    "build:production": "node scripts/build-production.mjs",
    "build:textures": "node scripts/build-globe-textures.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:workers": "node --import tsx --test tests/contact.test.mjs tests/notifications.test.mjs tests/d1.test.mjs",
    "preview:cf": "wrangler dev --local --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check:export": "node scripts/check-export.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "check:fidelity": "node scripts/fidelity-compare.mjs",
    "content:index": "node scripts/build-content-index.mjs",
    "uploads:variants": "node scripts/build-upload-variants.mjs",
    "cms:vendor": "node scripts/vendor-sveltia.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "6.15.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "js-yaml": "4.2.0",
    "miniflare": "5.20261019.0-beta",
    "playwright": "1.64.0-alpha-1790635538000",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "wrangler": "4.151.2",
    "esbuild": "0.28.2"
  },
  "type": "module"
}
