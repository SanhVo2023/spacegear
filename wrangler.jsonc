{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spacegear-tech-preview",
  // Pinned: the spacegear Cloudflare account (admin@spacegear.tech), so a wrangler session logged in
  // to any other account can never deploy, add secrets or create resources there.
  "account_id": "70f5a062f4a976cef11502034420b538",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    // HTML navigations run the Worker first (worker/locale.ts: region redirect, ?lang= switch); /api/* still
    // does. Files (any path with a dot), build output, media, the CMS and every /vi/ page go straight to assets.
    // Negative rules win; "*" matches across "/" (miniflare's router, rules-engine).
    "run_worker_first": ["/*", "!/_next/*", "!/images/*", "!/textures/*", "!/uploads/*", "!/admin/*", "!/vi/*", "!/*.*"]
  },
  "vars": {
    "SITE_ORIGIN": "http://localhost:8787",
    "CONTACT_ENABLED": "false",
    "NOTIFICATIONS_ENABLED": "false",
    "OWNER_EMAIL": "",
    "SENDER_EMAIL": "",
    "GITHUB_CLIENT_ID": "",
    "GITHUB_OAUTH_SCOPE": "public_repo",
    // The local preview reads the visitor's country from the x-sg-test-country header (worker/locale.ts), never in production.
    "LOCALE_TEST_HEADER": "true"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "spacegear-preview", "migrations_dir": "./migrations" }],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "production": {
      "name": "spacegear-tech",
      "workers_dev": false,
      "routes": [{ "pattern": "spacegear.tech", "custom_domain": true }],
      "vars": {
        "SITE_ORIGIN": "https://spacegear.tech",
        "CONTACT_ENABLED": "true",
        "NOTIFICATIONS_ENABLED": "false",
        "OWNER_EMAIL": "",
        "SENDER_EMAIL": "",
        "GITHUB_CLIENT_ID": "Ov23liI3hsIsE2jT7eFc",
        "GITHUB_OAUTH_SCOPE": "public_repo",
        "LOCALE_TEST_HEADER": "false"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "spacegear-production", "database_id": "b618e082-fb6d-4d78-9b85-c2a5bb350a7d", "migrations_dir": "./migrations" }],
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": ["*/5 * * * *"] }
    }
  }
}
