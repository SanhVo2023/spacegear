# Public production build values for npm run build:production (scripts/build-production.mjs).
# Every value here is already public in the live pages. A variable set in the build environment
# wins over its line here. Secrets never go in this file: they are Worker secrets (README.md).
# One KEY=VALUE per line, without quotes, spaces or comments after the value.
# Not named .env.production on purpose: Next would load that into preview builds too.
NEXT_PUBLIC_SITE_URL=https://spacegear.tech
NEXT_PUBLIC_CONTACT_EMAIL=admin@spacegear.tech
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFg-V2bSRNV87fkb
POLICIES_APPROVED=true
